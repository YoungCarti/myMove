rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /publicVehicles/{vehicleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Simplification, or restrict
    }

    match /qrCodes/{qrCodeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /chats/{chatId} {
      // Allow if the user is a participant
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        // Technically we should check the parent chat, but allowing if authenticated is a start.
        allow read, create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Anyone can view parking locations, but only admin/functions can modify
    match /parking_locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    // Mail documents can ONLY be created with the exact OTP email shape.
    match /mail/{mailId} {
      allow create: if
        request.resource.data.keys().hasAll(['to', 'message']) &&
        request.resource.data.keys().hasOnly(['to', 'message']) &&
        request.resource.data.to is string &&
        request.resource.data.to.size() > 0 &&
        request.resource.data.message.keys().hasAll(['subject', 'html']) &&
        request.resource.data.message.keys().hasOnly(['subject', 'html']) &&
        request.resource.data.message.subject == 'myMove - Verify Your Email' &&
        request.resource.data.message.html is string &&
        request.resource.data.message.html.size() > 0 &&
        request.resource.data.message.html.size() < 5000;
      allow read, update, delete: if false;
    }

    // Bookings are strictly managed by Cloud Functions
    match /bookings/{bookingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; 
    }

    // Location locks are internal to Cloud Functions — no client access
    match /location_locks/{lockId} {
      allow read, write: if false;
    }
  }
}
