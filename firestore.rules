rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone can view parking locations, but only admin/functions can modify
    match /parking_locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    // Authenticated users can send emails via the Firebase extension
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Bookings are strictly managed by Cloud Functions
    match /bookings/{bookingId} {
      // Users can only read their own bookings
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // All writes (create, update, delete, spot assignment) are handled securely by Cloud Functions
      allow write: if false; 
    }
  }
}
