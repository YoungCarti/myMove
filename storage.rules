rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && imageId == request.auth.uid + '.jpg';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
