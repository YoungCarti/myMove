rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && imageId == request.auth.uid + '.jpg';
    }
    match /move_requests/{imageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
